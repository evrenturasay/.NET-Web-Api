<!DOCTYPE html>
@{
    ViewBag.Title = "File Upload";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<html>
<head>

    <link rel="stylesheet" href="sweetalert2.min.css">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Upload</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h3 class="card-title mb-0">
                            <i class="fas fa-upload"></i> Upload File
                        </h3>
                    </div>
                    <div class="card-body">

                        @using (Html.BeginForm("Upload", "File", FormMethod.Post, new { enctype = "multipart/form-data", @class = "needs-validation", novalidate = "novalidate" }))
                        {
                            <div class="mb-4">
                                <label for="uploadedFile" class="form-label">
                                    <i class="fas fa-file"></i> Select File:
                                </label>

                                <div class="upload-area border border-2 border-dashed p-4 text-center" id="uploadArea">
                                    <div class="upload-content">
                                        <i class="fas fa-cloud-upload-alt fa-3x text-muted mb-3"></i>
                                        <p class="text-muted mb-2">Drag file here or click to select</p>
                                        <input type="file" name="uploadedFile" id="uploadedFile" class="form-control d-none" required accept=".pdf,.doc,.docx,.xls,.xslx,.xlsm" />
                                        <button type="button" class="btn btn-outline-primary" onclick="document.getElementById('uploadedFile').click()">
                                            <i class="fas fa-folder-open"></i> Select File
                                        </button>
                                    </div>
                                    <div class="selected-file d-none" id="selectedFile">
                                        <i class="fas fa-file-alt fa-2x text-success mb-2"></i>
                                        <p class="file-name mb-1"></p>
                                        <p class="file-size text-muted mb-0"></p>
                                    </div>
                                </div>

                                <div class="invalid-feedback">
                                    Please Select a File to Upload
                                </div>

                                <small class="form-text text-muted">
                                    <i class="fas fa-info-circle"></i>
                                    Supported File Types: PDF, DOC, DOCX, XLS, XLSM, XLSX
                                </small>
                            </div>

                            <div class="progress d-none mb-3" id="uploadProgress">
                                <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%"></div>
                            </div>

                            <div class="d-flex justify-content-between">
                                <button type="submit" class="btn btn-success btn-lg" id="uploadBtn" disabled>
                                    <i class="fas fa-upload"></i> Upload
                                </button>
                                @Html.ActionLink("List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/Scripts/UploadScript.js"></script>
</body>
</html>