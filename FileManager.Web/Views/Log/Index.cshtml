@model IEnumerable<FileManager.Models.LogRecord>
@{
    ViewBag.Title = "Log List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Log List</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

    <style>

        td.exception-cell {
            max-width: 250px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            cursor: default;
            text-align: left;
        }
    </style>
</head>
<body>
    <div class="container-fluid mt-4">
        <div class="row justify-content-center">
            <div class="col-md-12">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h3 class="card-title mb-0">
                            <i class="fas fa-list"></i> Logs
                        </h3>
                    </div>
                    <div class="card-body">

                        @if (TempData["Message"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="fas fa-check-circle"></i> @TempData["Message"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @if (!Model.Any())
                        {
                            <div class="alert alert-info text-center">
                                <i class="fas fa-info-circle"></i> No Logs Yet.

                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table id="logTable" class="table table-bordered align-middle text-center table-striped" style="min-width: 1200px; width: 100%;">
                                    <thead class="table-light">
                                        <tr>
                                            <th>#</th>
                                            <th>Log Date</th>
                                            <th>File Name</th>
                                            <th>State</th>
                                            <th>Message</th>
                                            <th>Exception</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var log in Model.Select((l, i) => new { Log = l, Index = i + 1 }))
                                        {
                                            <tr>
                                                <td>@log.Index</td>
                                                <td>@log.Log.LogDate.ToString("dd.MM.yyyy HH:mm")</td>
                                                <td>@log.Log.FileName</td>
                                                <td>@log.Log.State</td>
                                                <td>@log.Log.Message</td>
                                                <td class="exception-cell">
                                                    @log.Log.Exception
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>


    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>


    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#logTable').DataTable({
                "order": [[1, "desc"]],
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.4/i18n/en.json"
                },
                "columnDefs": [
                    { "orderable": false, "targets": 5 }
                ]
            });
        });
    </script>
</body>
</html>
